# Environment Configuration
# Copy this file to .env and fill in your actual API keys

# LLM Provider Selection (choose one)
LLM_PROVIDER=groq  # Options: openai, anthropic, groq, ollama

# Groq API (Fast and Cost-Effective)
GROQ_API_KEY=gsk-your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative models: llama-3.1-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it

# OpenAI API (Primary LLM for schema induction and query translation)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_MINI=gpt-4o-mini

# Anthropic API (Fallback LLM)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (Optional - for local LLM)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Database Configuration
DUCKDB_PATH=./data/structrag.db
CHROMADB_PATH=./data/chromadb

# Server Configuration
MCP_SERVER_NAME=StructRAG
MCP_SERVER_VERSION=0.1.0
LOG_LEVEL=INFO

# Performance Tuning
MAX_CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_QUERY_TIMEOUT=30
MAX_DOCS_PER_INGESTION=1000
